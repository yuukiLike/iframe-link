{
  "name": "iframe-link",
  "version": "1.0.0",
  "packageManager": "pnpm@11.14.0",
  "description": "Minimalist iframe communication for JavaScript and TypeScript, with Promise-based RPC and events over postMessage.",
  "keywords": [
    "iframe",
    "iframe-rpc",
    "postmessage",
    "postmessage-rpc",
    "rpc",
    "events",
    "cross-origin",
    "handshake",
    "typescript",
    "minimalist"
  ],
  "author": "yuukiLike <YuukiJyoudai@outlook.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuukiLike/iframe-link.git"
  },
  "bugs": {
    "url": "https://github.com/yuukiLike/iframe-link/issues"
  },
  "homepage": "https://github.com/yuukiLike/iframe-link#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs/README.zh-CN.md",
    "docs/README.ja.md",
    "docs/THIRD_PARTY_NOTICES.md",
    "docs/assets"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "dev": "concurrently \"tsup --config config/tsup.config.ts --watch\" \"live-server --port=3000 --open=/examples/index.html --wait=1000\"",
    "build": "tsup --config config/tsup.config.ts",
    "demo": "pnpm run build && live-server --port=3000 --open=/examples/index.html",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm install --frozen-lockfile && pnpm run test:all",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:coverage": "vitest run --config config/vitest.config.ts --coverage",
    "test:e2e": "pnpm run build && playwright test --config config/playwright.config.ts",
    "test:e2e:ui": "playwright test --config config/playwright.config.ts --ui",
    "test:all": "pnpm run test && pnpm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/debug": "^4.1.12",
    "@types/node": "^25.0.6",
    "@vitest/coverage-v8": "^1.0.0",
    "concurrently": "^9.2.1",
    "debug": "^4.4.3",
    "happy-dom": "^12.0.0",
    "live-server": "^1.2.2",
    "serve": "^14.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
